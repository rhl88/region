{
    "id": "cmspro.region",
    "name": "中国行政区划",
    "description": "中国行政区划数据服务，支持省、市、区县三级联动及街道四级、村/社区五级可选，支持“行政区边界”查询，提供API供其他应用调用",
    "version": "1.7.0",
    "author": "CmsPro",
    "icon": "fa fa-map-marker",
    "require": {
        "php": ">=8.3",
        "cmspro": ">=5.0.0"
    },
    "providers": [
        "ServiceProvider"
    ],
    "install": "Install",
    "hooks": "Hooks",
    "menus": [
        {
            "title": "行政区划",
            "icon": "fa fa-map-marker",
            "path": "/admin/cmspro/regions",
            "code": "admin_cmspro_region_groups",
            "order": 100,
            "children": [
                {
                    "title": "数据管理",
                    "icon": "fa fa-database",
                    "path": "/admin/cmspro/region",
                    "code": "admin_cmspro_region",
                    "order": 1
                },
                {
                    "title": "数据演示",
                    "icon": "fa fa-eye",
                    "path": "/admin/cmspro/region/demo",
                    "code": "admin_cmspro_region_demo",
                    "order": 2
                },
                {
                    "title": "应用设置",
                    "icon": "fa fa-cog",
                    "path": "/admin/cmspro/region/setting",
                    "code": "admin_cmspro_region_setting",
                    "order": 3
                }
            ]
        }
    ],
    "home_menus": [
        {
            "title": "区划演示",
            "icon": "fa fa-map-marker",
            "path": "/cmspro/region/demo",
            "code": "home_cmspro_region_demo",
            "order": 50
        }
    ],
    "permissions": [
        {
            "code": "cmspro.region.manage",
            "name": "区划管理"
        },
        {
            "code": "cmspro.region.import",
            "name": "数据导入"
        },
        {
            "code": "cmspro.region.export",
            "name": "数据导出"
        },
        {
            "code": "cmspro.region.setting.manage",
            "name": "应用设置管理"
        }
    ],
    "config_groups": [
        {
            "name": "sync_settings",
            "title": "数据同步设置",
            "items": [
                {
                    "name": "data_sync_version",
                    "title": "已同步数据版本",
                    "type": "text",
                    "value": "",
                    "tips": "最近一次在线同步的官方区划数据版本号（系统自动维护，请勿手工修改）"
                },
                {
                    "name": "data_sync_level",
                    "title": "已同步数据级别",
                    "type": "text",
                    "value": "",
                    "tips": "最近一次在线同步落库的最大区划级别：3=省市区县、4=含街道、5=含村/社区（系统自动维护，请勿手工修改）"
                }
            ]
        },
        {
            "name": "region_settings",
            "title": "区划设置",
            "items": [
                {
                    "name": "region_max_level",
                    "title": "区划显示级别",
                    "type": "text",
                    "value": "5",
                    "tips": "数据演示页「区划选择器」显示的最大级别：1=省、2=市、3=区县、4=街道、5=村/社区。在线同步时所选级别会自动写入本项；仅影响演示页选择器，不改变对外 API 返回。"
                }
            ]
        },
        {
            "name": "map_settings",
            "title": "地图设置",
            "items": [
                {
                    "name": "map_source",
                    "title": "地图配置来源",
                    "type": "text",
                    "value": "none",
                    "tips": "none=不启用厂商地图，数据演示页使用 Leaflet + 高德瓦片底图；own=使用本应用下方独立配置的厂商与密钥；maps=跟随「地图」应用（CmsproMaps）的厂商与前端密钥。"
                },
                {
                    "name": "map_provider",
                    "title": "地图厂商",
                    "type": "text",
                    "value": "baidu",
                    "tips": "仅在配置来源为「独立配置」时生效，可选 tencent（腾讯地图）、amap（高德地图）、baidu（百度地图）。"
                },
                {
                    "name": "tencent_js_key",
                    "title": "腾讯地图 JS API Key",
                    "type": "password",
                    "value": "",
                    "tips": "请到腾讯位置服务开放平台（lbs.qq.com）自行申请密钥；创建 Key 时勾选「Web端 JavaScript GL」，并在控制台配置 Referer 域名白名单。本应用不内置任何密钥。"
                },
                {
                    "name": "amap_js_key",
                    "title": "高德地图 JS API Key",
                    "type": "password",
                    "value": "",
                    "tips": "请到高德开放平台（lbs.amap.com）自行申请密钥；应用类型须选择「Web端(JS API)」，并在控制台配置域名白名单。本应用不内置任何密钥。"
                },
                {
                    "name": "amap_security_code",
                    "title": "高德安全密钥 securityJsCode",
                    "type": "password",
                    "value": "",
                    "tips": "高德 JS API 2.0 自 2021-12-02 起强制要求安全密钥，不填将报 INVALID_USER_SCODE。"
                },
                {
                    "name": "baidu_js_ak",
                    "title": "百度地图 JS API AK",
                    "type": "password",
                    "value": "",
                    "tips": "请到百度地图开放平台（lbsyun.baidu.com）自行申请密钥；应用类型须选择「浏览器端」并开启 JavaScript GL，同时在控制台配置 Referer 白名单。本应用不内置任何密钥。"
                }
            ]
        }
    ],
    "runtime_files": [
        {
            "key": "region_data",
            "name": "行政区划数据文件",
            "dir": "app/Apps/CmsproRegion/Data",
            "type": "ipdb",
            "description": "从 GitHub 下载的行政区划数据源（list.json 及区县街道 code/*.json），可重新下载生成",
            "cleanable": true,
            "strategy": "manual",
            "pattern": ["list.json", "code/*.json"],
            "protected": false
        }
    ]
}